<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdzx.student.mapper.SubjectMapper">

  <!-- 读取学科编码、满分和展示顺序，排序以数据库配置为准。 -->

  <select id="selectAll" resultType="com.mdzx.student.domain.Subject">
    SELECT subject_key, subject_name, full_score, sort_no
    FROM subject
    ORDER BY sort_no
  </select>
</mapper>
